# AdaptiveSec Environment Variables
# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# Neo4j AuraDB — https://neo4j.com/cloud/aura (free tier available)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Redis — run locally with Docker:
#   docker run -d -p 6379:6379 redis
REDIS_URL=redis://localhost:6379

# RabbitMQ — run locally with Docker:
#   docker run -d --name rabbitmq -p 5672:5672 rabbitmq:management
RABBITMQ_URL=amqp://localhost

# JWT — generate a random secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Google Gemini API — https://aistudio.google.com (free tier available)
GEMINI_API_KEY=

# Ollama local LLM fallback (optional)
# Set to true if you install Ollama: https://ollama.com
# Then run: ollama pull llama3.2:3b
# Leave false to use keyword fallback when Gemini fails
USE_OLLAMA=false